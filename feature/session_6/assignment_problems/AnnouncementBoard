
class RaceEntry {
    protected String bibNumber;
    protected double entryFee;
    protected double amountPaid;

    public RaceEntry(String bibNumber, double entryFee) {
        if (bibNumber == null || bibNumber.trim().length() < 4) {
            throw new IllegalArgumentException("Invalid Bib Number");
        }

        this.bibNumber = bibNumber;
        this.entryFee = entryFee;
        this.amountPaid = 0;
    }

    public void pay(double amount) {
        amountPaid += amount;
    }

    public double getBalanceDue() {
        return entryFee - amountPaid;
    }

    public String announce() {
        return "Race Entry | Bib: " + bibNumber
                + " | Balance: " + getBalanceDue();
    }

    public static String announceAll(RaceEntry[] entries) {

        StringBuilder sb = new StringBuilder();

        for (RaceEntry e : entries) {

            // Polymorphic method call
            sb.append(e.announce());

            // Safe downcasting
            if (e instanceof RelayTeamEntry) {

                RelayTeamEntry r = (RelayTeamEntry) e;

                sb.append(" [Team size via downcast: ");
                sb.append(r.teamSize);
                sb.append("]");
            }

            sb.append(" | ");
        }

        return sb.toString();
    }
}

class RunnerEntry extends RaceEntry {
    String category;

    public RunnerEntry(String bibNumber, double entryFee, String category) {
        super(bibNumber, entryFee);
        this.category = category;
    }

    @Override
    public String announce() {
        return "Runner Entry | Bib: " + bibNumber
                + " | Category: " + category
                + " | Balance: " + getBalanceDue();
    }
}

class RelayTeamEntry extends RaceEntry {
    int teamSize;

    public RelayTeamEntry(String bibNumber, double entryFee, int teamSize) {
        super(bibNumber, entryFee);
        this.teamSize = teamSize;
    }

    @Override
    public String announce() {
        return "Relay Team | Bib: " + bibNumber
                + " | Team Size: " + teamSize
                + " | Balance: " + getBalanceDue();
    }
}

public class AnnouncementBoard {
    public static void main(String[] args) {

        RunnerEntry r = new RunnerEntry(
            "BIB2001", 80, "Open 10K"
        );

        RelayTeamEntry t = new RelayTeamEntry(
            "BIB4001", 300, 4
        );

        RaceEntry[] entries = {r, t};

        System.out.println(RaceEntry.announceAll(entries));

        // Unsafe downcasting example
        RaceEntry plain = new RaceEntry("BIB5001", 50);

        // This would throw ClassCastException:
        // RelayTeamEntry bad = (RelayTeamEntry) plain;
    }
}
