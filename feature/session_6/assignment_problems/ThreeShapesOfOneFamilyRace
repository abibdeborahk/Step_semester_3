public class ThreeShapeOfOneFamily {
    public static void main(String[] args) {

        RunnerEntry r = new RunnerEntry("BIB2001", 80, "Open 10K");

        EliteRunnerEntry e = new EliteRunnerEntry(
                "BIB3001", 150, "Elite Full Marathon", 500);

        RelayTeamEntry t = new RelayTeamEntry("BIB4001", 300, 4);

        System.out.println(RaceEntry.classifyGeneration(e));
        System.out.println(RaceEntry.classifyGeneration(t));

        RaceEntry[] entries = {r, e, t};

        System.out.println(RaceEntry.getTotalBalanceDue(entries));
    }
}